# Modelo de configuracao. Copie este arquivo para .env e preencha a senha.
# O arquivo .env real NAO sobe para o GitHub (esta no .gitignore).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cofreseguro
DB_USER=root
DB_PASSWORD=

# Modo debug do Flask: deixe false em producao (true expoe o console do Werkzeug)
FLASK_DEBUG=false

# TLS/HTTPS (opcional). Gere o certificado com: python gerar_cert.py
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem
